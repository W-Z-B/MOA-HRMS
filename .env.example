# Copy to .env and fill in. Placeholders only; never commit real values.
DOMAIN=hrms.localhost
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_scripts/gen-secret.sh
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=hrms.localhost,localhost,api,hrms-api
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_byte_urlsafe_base64
DB_HOST=db
DB_PORT=5432
DB_NAME=hrms
DB_USER=hrms
DB_PASSWORD=CHANGE_ME
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hrms@gsa.edu.gy
TZ=America/Guyana
# Optional limits; the defaults suit production.
# SESSION_IDLE_MINUTES=30              # sign out after this long without activity (8 hours at most in all)
# LOGIN_MAX_FAILURES_PER_ADDRESS=20    # failed sign-ins from one address, any accounts, per 15 minutes
# UPLOAD_LIMIT_EVIDENCE_MB=10
# UPLOAD_LIMIT_DOCUMENT_MB=20
# API_DOCS_PUBLIC=1                    # API documentation without signing in; defaults to DJANGO_DEBUG
# PUBLIC_URL=https://hrms.gsa.edu.gy     # the address in emailed links; defaults to https:// and the first allowed host
# INVITATION_DAYS=7                    # how long an invitation to a new account works
# PASSWORD_RESET_MINUTES=60            # how long a link to choose a new password works
# PASSWORD_RESETS_PER_ADDRESS=5        # requests for a link from one address per 15 minutes
# PRIVACY_RESPONSE_DAYS=30             # days HR has to answer a request to correct a record
# Optional, development and staging only: seed_demo gives every invented employee an account with
# this password. Leave empty and no accounts are created.
DEMO_USER_PASSWORD=
